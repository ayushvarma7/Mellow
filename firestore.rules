rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /progress/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /checkins/{checkinId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /moods/{moodId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Username registry
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    // Buddy requests — readable/writable only by sender or receiver
    match /buddyRequests/{requestId} {
      allow read: if request.auth != null
                  && (resource.data.fromUid == request.auth.uid
                      || resource.data.toUid == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.toUid == request.auth.uid;
    }

    // Buddy groups — readable/writable only by members
    match /buddyGroups/{groupId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.members;
      allow update, delete: if request.auth != null
                            && request.auth.uid in resource.data.members;

    }

    // Nudges — sender can create, receiver can read and mark seen
    match /nudges/{nudgeId} {
      allow read: if request.auth != null
                  && (resource.data.senderUid == request.auth.uid
                      || resource.data.receiverUid == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.senderUid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.receiverUid == request.auth.uid;
    }

  }
}
