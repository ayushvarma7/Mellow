<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card"
    android:padding="12dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="42dp"
        android:layout_height="46dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/shape_round_12"
        android:backgroundTint="@color/mellow_canvas_2">

        <TextView
            android:id="@+id/tvRowMon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SEP"
            android:textColor="@color/mellow_ink_2"
            android:textSize="9.5sp"
            android:fontFamily="@font/jakarta_bold" />

        <TextView
            android:id="@+id/tvRowDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12"
            android:textColor="@color/mellow_ink"
            android:textSize="16sp"
            android:fontFamily="@font/jakarta_extrabold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tvRowMood"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Overjoyed"
            android:textColor="@color/mellow_ink"
            android:textSize="15sp"
            android:fontFamily="@font/jakarta_bold" />

        <TextView
            android:id="@+id/tvRowTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="08:11 AM"
            android:textColor="@color/mellow_ink_2"
            android:textSize="12sp"
            android:fontFamily="@font/jakarta" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivRowFace"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/mood_face_overjoyed"
        android:contentDescription="mood" />
</LinearLayout>
