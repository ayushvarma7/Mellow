<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mellow_canvas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingTop="@dimen/screen_gutter">

        <!-- ===== FIXED HEADER ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/mellow_ink"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Journal"
                android:textAppearance="@style/TextAppearance.Mellow.Display"
                android:textSize="23sp"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Prompt hero -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_prompt">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:paddingEnd="78dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today's prompt"
                    android:textAppearance="@style/TextAppearance.Mellow.Label"
                    android:textColor="@color/mellow_lav_deep" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="What's one small thing that gave you a moment of calm today?"
                    android:textAppearance="@style/TextAppearance.Mellow.Quote"
                    android:textSize="17sp"
                    android:layout_marginTop="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartWriting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Start writing"
                    android:textAllCaps="false"
                    android:textSize="13.5sp"
                    android:fontFamily="@font/jakarta_bold"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/mellow_lav"
                    app:cornerRadius="14dp"
                    android:layout_marginTop="14dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="bottom|end"
                android:src="@drawable/ic_sprout"
                android:contentDescription="Sprout" />
        </FrameLayout>

        <!-- Insight strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="9dp"
                android:orientation="vertical" android:gravity="center"
                android:background="@drawable/bg_card" android:padding="14dp">
                <TextView android:id="@+id/tvJEntries" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0"
                    android:textAppearance="@style/TextAppearance.Mellow.Number" android:textSize="22sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="entries" android:textColor="@color/mellow_ink_2" android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="9dp"
                android:orientation="vertical" android:gravity="center"
                android:background="@drawable/bg_card" android:padding="14dp">
                <TextView android:id="@+id/tvJStreak" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0"
                    android:textAppearance="@style/TextAppearance.Mellow.Number" android:textSize="22sp"
                    android:textColor="@color/mellow_coral_deep" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="day streak" android:textColor="@color/mellow_ink_2" android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical" android:gravity="center"
                android:background="@drawable/bg_card" android:padding="12dp">
                <ImageView android:id="@+id/ivJMood" android:layout_width="30dp" android:layout_height="30dp"
                    android:src="@drawable/mood_face_happy"
                    android:contentDescription="recent mood" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="recent mood" android:textColor="@color/mellow_ink_2" android:textSize="11sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recent entries"
            android:textAppearance="@style/TextAppearance.Mellow.Label"
            android:layout_marginStart="2dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp" />

        <!-- ===== SCROLLING AREA (only this moves) ===== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvJournals"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="96dp" />

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingBottom="40dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/ic_sprout"
                    android:contentDescription="Sprout" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Take a quiet moment"
                    android:textAppearance="@style/TextAppearance.Mellow.Display"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Write one small thought or feeling from today."
                    android:textColor="@color/mellow_ink_2"
                    android:textSize="14sp"
                    android:fontFamily="@font/jakarta" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmptyWrite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Write an entry"
                    android:textAllCaps="false"
                    android:textSize="14.5sp"
                    android:fontFamily="@font/jakarta_bold"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/mellow_coral"
                    app:cornerRadius="16dp"
                    android:paddingHorizontal="22dp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddJournal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="Add Journal"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/mellow_coral"
        app:tint="@color/white" />

</FrameLayout>
