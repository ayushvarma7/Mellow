<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="26dp"
    android:paddingEnd="26dp"
    android:paddingTop="28dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="What are the things that make you happy?"
        android:textAppearance="@style/TextAppearance.Mellow.Display"
        android:textSize="30sp"
        android:lineSpacingMultiplier="1.08" />

    <!-- total + search -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="14dp">

        <TextView
            android:id="@+id/tvHappyTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 Total"
            android:textColor="@color/mellow_ink_2"
            android:textSize="13sp"
            android:fontFamily="@font/jakarta_bold" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <EditText
            android:id="@+id/etHappySearch"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:hint="Search"
            android:textColorHint="@color/mellow_ink_3"
            android:textColor="@color/mellow_ink"
            android:textSize="13.5sp"
            android:fontFamily="@font/jakarta"
            android:background="@drawable/shape_pill"
            android:backgroundTint="@color/mellow_surface"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:maxLines="1"
            android:inputType="text"
            android:drawableEnd="@drawable/ic_search"
            android:drawablePadding="6dp"
            android:importantForAutofill="no" />
    </LinearLayout>

    <!-- tag cloud -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipsHappy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="2dp" />
    </ScrollView>

    <!-- selected -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selected:"
            android:textColor="@color/mellow_ink_2"
            android:textSize="12.5sp"
            android:fontFamily="@font/jakarta_bold"
            android:layout_marginEnd="8dp" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipsSelected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:chipSpacingHorizontal="6dp" />
        </HorizontalScrollView>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnHappyContinue"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="12dp"
        android:text="Continue"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:fontFamily="@font/jakarta_bold"
        android:backgroundTint="@color/mellow_ink"
        app:icon="@drawable/ic_chevron_right"
        app:iconGravity="textEnd"
        app:iconTint="@color/white"
        app:cornerRadius="20dp" />
</LinearLayout>
