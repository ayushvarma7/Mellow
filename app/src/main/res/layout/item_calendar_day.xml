<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- kept for binding compatibility -->
    <TextView
        android:id="@+id/tvDayMood"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/cardDay"
        android:layout_width="34dp"
        android:layout_height="34dp">

        <View
            android:id="@+id/todayRing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/ring_today"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ivDayFace"
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:layout_gravity="center"
            android:src="@drawable/mood_face_neutral"
            android:contentDescription="mood" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvDayNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="1"
        android:textColor="@color/mellow_ink_2"
        android:textSize="10.5sp"
        android:fontFamily="@font/jakarta_bold" />
</LinearLayout>
