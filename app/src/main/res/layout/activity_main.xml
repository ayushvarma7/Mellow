<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mellow_canvas"
    android:clipChildren="false">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="118dp"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_gutter"
            android:paddingTop="56dp"
            android:paddingBottom="16dp">

            <!-- ===================== TOP BAR ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDateLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TODAY"
                        android:textAppearance="@style/TextAppearance.Mellow.Label" />

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Good afternoon"
                        android:textAppearance="@style/TextAppearance.Mellow.Display" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnThemeToggle"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="☀"
                    android:textSize="20sp"
                    android:background="@drawable/shape_round_14"
                    android:backgroundTint="@color/mellow_canvas_2"
                    android:contentDescription="Settings and theme"
                    android:layout_marginEnd="10dp" />

                <FrameLayout
                    android:id="@+id/fabMenu"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/shape_round_14"
                    android:backgroundTint="@color/mellow_lav"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Your profile">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="AV"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="16sp" />
                </FrameLayout>
            </LinearLayout>

            <!-- ===================== REWARD JAR HERO ===================== -->
            <LinearLayout
                android:id="@+id/cardHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp"
                android:padding="20dp"
                android:background="@drawable/bg_hero_honey"
                android:elevation="8dp">

                <ImageView
                    android:layout_width="76dp"
                    android:layout_height="90dp"
                    android:src="@drawable/ic_jar"
                    android:contentDescription="Coin jar" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="true"
                        android:gravity="bottom">

                        <TextView
                            android:id="@+id/tvJarCoins"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="34sp"
                            android:letterSpacing="-0.02" />

                        <TextView
                            android:id="@+id/tvJarCap"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:layout_marginBottom="4dp"
                            android:text="/ 7 coins"
                            android:textColor="#F2FFFFFF"
                            android:textStyle="bold"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvJarSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Complete check-ins to fill your jar"
                        android:textColor="#EEFFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_track_white"
                        android:weightSum="100">

                        <View
                            android:id="@+id/heroFill"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0"
                            android:background="@drawable/bg_fill_white" />

                        <View
                            android:id="@+id/heroSpacer"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="100" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvJarNote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="KEEP GOING TO UNLOCK A REWARD"
                        android:textColor="#DDFFFFFF"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:letterSpacing="0.04" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===================== STAT TILES ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:baselineAligned="false">

                <!-- streak -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="15dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/shape_round_12"
                        android:backgroundTint="@color/mellow_coral_soft">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_flame"
                            app:tint="@color/mellow_coral_deep"
                            android:contentDescription="Streak" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvStreak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="0 days"
                        android:textAppearance="@style/TextAppearance.Mellow.Number" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Current streak"
                        android:textAppearance="@style/TextAppearance.Mellow.Caption" />
                </LinearLayout>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <!-- total coins -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="15dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/shape_round_12"
                        android:backgroundTint="@color/mellow_honey_soft">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_coin"
                            app:tint="@color/mellow_honey_deep"
                            android:contentDescription="Coins" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvCoinsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="0"
                        android:textAppearance="@style/TextAppearance.Mellow.Number" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Total coins"
                        android:textAppearance="@style/TextAppearance.Mellow.Caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===================== AFFIRMATION ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:padding="18dp"
                android:background="@drawable/bg_tile"
                android:backgroundTint="@color/mellow_lav_soft">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DAILY AFFIRMATION"
                    android:textColor="@color/mellow_lav_deep"
                    android:textStyle="bold"
                    android:textSize="11.5sp"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvAffirmation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Your calm is your superpower."
                    android:textAppearance="@style/TextAppearance.Mellow.Quote" />
            </LinearLayout>

            <!-- ===================== SECTION HEADER ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Today's tools"
                    android:textAppearance="@style/TextAppearance.Mellow.Headline" />

                <TextView
                    android:id="@+id/btnViewJournalHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="History →"
                    android:textColor="@color/mellow_honey_deep"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:padding="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />
            </LinearLayout>

            <!-- ===================== QUICK TILES ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- journal -->
                <LinearLayout
                    android:id="@+id/cardJournal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:minHeight="112dp"
                    android:padding="14dp"
                    android:background="@drawable/bg_tile"
                    android:backgroundTint="@color/mellow_lav_soft"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/shape_round_12"
                        android:backgroundTint="#66FFFFFF">

                        <ImageView
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_journal"
                            app:tint="@color/mellow_lav_deep"
                            android:contentDescription="Journal" />
                    </FrameLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Journal"
                        android:textColor="@color/mellow_lav_deep"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+10 coins"
                        android:textColor="@color/mellow_lav_deep"
                        android:alpha="0.8"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Space android:layout_width="11dp" android:layout_height="1dp" />

                <!-- mood -->
                <LinearLayout
                    android:id="@+id/tileMood"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:minHeight="112dp"
                    android:padding="14dp"
                    android:background="@drawable/bg_tile"
                    android:backgroundTint="@color/mellow_sky_soft"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/shape_round_12"
                        android:backgroundTint="#66FFFFFF">

                        <ImageView
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_mood"
                            app:tint="@color/mellow_sky_deep"
                            android:contentDescription="Mood" />
                    </FrameLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Mood"
                        android:textColor="@color/mellow_sky_deep"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Log now"
                        android:textColor="@color/mellow_sky_deep"
                        android:alpha="0.8"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Space android:layout_width="11dp" android:layout_height="1dp" />

                <!-- buddies -->
                <LinearLayout
                    android:id="@+id/tileBuddies"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:minHeight="112dp"
                    android:padding="14dp"
                    android:background="@drawable/bg_tile"
                    android:backgroundTint="@color/mellow_sage_soft"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/shape_round_12"
                        android:backgroundTint="#66FFFFFF">

                        <ImageView
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_buddies"
                            app:tint="@color/mellow_sage_deep"
                            android:contentDescription="Buddies" />
                    </FrameLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Buddies"
                        android:textColor="@color/mellow_sage_deep"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Say hi"
                        android:textColor="@color/mellow_sage_deep"
                        android:alpha="0.8"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===================== PRIMARY CTA ===================== -->
            <LinearLayout
                android:id="@+id/btnStartCheckin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:padding="18dp"
                android:background="@drawable/bg_cta_coral"
                android:elevation="8dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:src="@drawable/ic_flame"
                    app:tint="#FFFFFF"
                    android:contentDescription="" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Start today's check-in"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16.5sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ===================== FLOATING BOTTOM NAV ===================== -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:background="@drawable/bg_nav"
        android:elevation="12dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView android:layout_width="23dp" android:layout_height="23dp"
                android:src="@drawable/ic_home" app:tint="@color/mellow_honey_deep"
                android:contentDescription="Home" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:text="Home" android:textSize="10.5sp"
                android:textStyle="bold" android:textColor="@color/mellow_honey_deep" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navRewards"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView android:layout_width="23dp" android:layout_height="23dp"
                android:src="@drawable/ic_mood" app:tint="@color/mellow_ink_3"
                android:contentDescription="Mood" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:text="Mood" android:textSize="10.5sp"
                android:textStyle="bold" android:textColor="@color/mellow_ink_3" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/navCheckIn"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginHorizontal="6dp"
            android:translationY="-14dp"
            android:background="@drawable/bg_cta_coral"
            android:elevation="6dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Start check-in">
            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_flame"
                app:tint="#FFFFFF"
                android:contentDescription="" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/navFriends"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView android:layout_width="23dp" android:layout_height="23dp"
                android:src="@drawable/ic_buddies" app:tint="@color/mellow_ink_3"
                android:contentDescription="Buddies" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:text="Buddies" android:textSize="10.5sp"
                android:textStyle="bold" android:textColor="@color/mellow_ink_3" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView android:layout_width="23dp" android:layout_height="23dp"
                android:src="@drawable/ic_profile" app:tint="@color/mellow_ink_3"
                android:contentDescription="You" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:text="You" android:textSize="10.5sp"
                android:textStyle="bold" android:textColor="@color/mellow_ink_3" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
