<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="26dp"
    android:paddingEnd="26dp"
    android:paddingTop="28dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="What should we\ncall you?"
        android:textAppearance="@style/TextAppearance.Mellow.Display"
        android:textSize="32sp"
        android:lineSpacingMultiplier="1.1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="This is how Mellow will greet you."
        android:textColor="@color/mellow_ink_2"
        android:textSize="14.5sp"
        android:fontFamily="@font/jakarta" />

    <EditText
        android:id="@+id/etName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:hint="Your name"
        android:textColorHint="@color/mellow_ink_3"
        android:textColor="@color/mellow_ink"
        android:textSize="18sp"
        android:fontFamily="@font/jakarta_bold"
        android:background="@drawable/rounded_edittext_bg"
        android:padding="18dp"
        android:maxLines="1"
        android:inputType="textPersonName|textCapWords"
        android:importantForAutofill="no" />

    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNameContinue"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:text="Continue"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:fontFamily="@font/jakarta_bold"
        android:backgroundTint="@color/mellow_ink"
        app:icon="@drawable/ic_chevron_right"
        app:iconGravity="textEnd"
        app:iconTint="@color/white"
        app:cornerRadius="20dp" />
</LinearLayout>
